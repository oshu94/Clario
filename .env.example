# ========================================================
# Clario — Environment Configuration (.env.example)
# ========================================================

# --- PayPal Sandbox Credentials (Server-Side Only) ---
# Retrieve from https://developer.paypal.com/dashboard/applications/sandbox
# NEVER commit your actual .env file or live credentials!
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Optional: Personal sandbox buyer account for dispute testing
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com

# --- AI Intelligence Engine Configuration ---
# Supported providers: "gemini" | "openai" | "demo"
# If AI_API_KEY is omitted, Clario runs in deterministic "DEMO" mode
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# --- Server Configuration ---
PORT=3000
NODE_ENV=development
